# SwingTrade Pro — environment configuration.
# Copy this file to ".env" and fill in your values. The app runs in offline mode
# (no live trading) when ALPACA_API_KEY is blank.

# Alpaca (paper/live) credentials — required only for live order execution
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional backtest cost overrides (basis points)
# SLIPPAGE_BPS=5
# COMMISSION_BPS=1

# Optional free-tier data-provider keys (used ONLY on their free tier — the app hard-stops
# before exceeding each provider's limit so you're never charged). You can also paste these
# in the app under Settings → Data & APIs. Leave blank to disable.
# Polygon.io / Massive — free Basic plan: 5 requests/minute. https://massive.com/pricing
POLYGON_API_KEY=
