# SwingTrade Pro — environment configuration.
# Copy this file to ".env" and fill in your values. The app runs in offline mode
# (no live trading) when ALPACA_API_KEY is blank.

# Alpaca (paper/live) credentials — required only for live order execution
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional backtest cost overrides (basis points)
# SLIPPAGE_BPS=5
# COMMISSION_BPS=1

# ── Login (streamlit-authenticator) ──────────────────────────────────────────
# First run seeds an admin account. Set a password here, or leave APP_ADMIN_PASSWORD
# blank to have one generated and shown once (also written to
# .data/INITIAL_ADMIN_PASSWORD.txt). AUTH_COOKIE_KEY signs the session cookie —
# set a long random value and keep it STABLE (required on hosted deploys so logins
# survive restarts).
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
AUTH_COOKIE_KEY=
# AUTH_COOKIE_NAME=swingtrade_auth
# AUTH_COOKIE_EXPIRY_DAYS=30
# Fallback only (used if streamlit-authenticator isn't installed): a single shared password.
# APP_PASSWORD=
